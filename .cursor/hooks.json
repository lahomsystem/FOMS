{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "python .cursor/hooks/session_start.py"
      }
    ],
    "sessionEnd": [
      {
        "command": "python .cursor/hooks/session_stop.py"
      }
    ],
    "stop": [
      {
        "command": "python .cursor/hooks/session_stop.py"
      }
    ],
    "afterFileEdit": [
      {
        "command": "python .cursor/hooks/track_edits.py"
      }
    ],
    "preCompact": [
      {
        "command": "python .cursor/hooks/pre_compact.py"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "python .cursor/hooks/guard_shell.py"
      }
    ],
    "afterAgentResponse": [
      {
        "command": "python .cursor/hooks/post_task_quality_check.py"
      }
    ]
  }
}