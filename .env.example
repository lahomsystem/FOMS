# FOMS 환경 변수 — 키 이름만 담는다. 값은 절대 커밋하지 않는다.
#
# 쓰는 법: 이 파일을 `.env` 로 복사한 뒤 필요한 값만 채운다(.env 는 .gitignore 대상).
# 키 이름은 코드에서 실제로 읽는 것만 넣었다. 새 키를 코드에 추가하면 여기에도 추가한다.
# 값이 비면 대부분 기능이 꺼지거나(no-op) 기본값으로 떨어진다 — 필수는 아래 [필수] 구역뿐이다.

# ── [필수] 앱이 뜨려면 있어야 하는 것 ─────────────────────────────────────────
DATABASE_URL=
SECRET_KEY=
FLASK_ENV=

# ── 실행·네트워크 ─────────────────────────────────────────────────────────────
PORT=
FOMS_ENV=
FOMS_BASE_URL=
BASE_URL=
CORS_ALLOWED_ORIGINS=
TRUST_PROXY=
FOMS_TRUSTED_PROXY_HOPS=
GUNICORN_CMD_ARGS=
FOMS_STARTUP_LOG_PATH=

# ── Redis (없으면 인메모리 폴백: Socket.IO 단일 워커·레이트리미터 인메모리) ──
REDIS_URL=
REDIS_PUBLIC_URL=

# ── 세션·인증·레이트리밋 ──────────────────────────────────────────────────────
FOMS_SESSION_DAYS=
FOMS_SHARE_TOKEN_DAYS=
FOMS_SIGNING_KEY_NEXT=
FOMS_ADMIN_DEFAULT_PASSWORD=
FLASK_DEFAULT_RATE_LIMITS=
FOMS_LAST_SEEN_TOUCH_SECONDS=

# ── 스토리지 (Cloudflare R2 / S3 호환) ────────────────────────────────────────
STORAGE_TYPE=
STORAGE_PUBLIC=
UPLOAD_FOLDER=
USE_DIRECT_UPLOAD=
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_CONNECT_TIMEOUT=
R2_READ_TIMEOUT=
S3_BUCKET_NAME=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── 썸네일·첨부 워커 ──────────────────────────────────────────────────────────
ASYNC_ATTACHMENT_THUMBNAIL=
ORDER_ATTACHMENT_THUMBNAIL_WORKERS=
CHAT_THUMBNAIL_WORKERS=

# ── 웹푸시 ────────────────────────────────────────────────────────────────────
FOMS_WEB_PUSH_ENABLED=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_SUB=
FOMS_PUSH_P1_TYPES=

# ── 알림·에스컬레이션 ─────────────────────────────────────────────────────────
FOMS_ESCALATION_MINUTES=
FOMS_ESCALATION_EXEMPT_TYPES=
ERP_DRAFT_STALE_HOURS=

# ── 카카오 ────────────────────────────────────────────────────────────────────
KAKAO_REST_API_KEY=
KAKAO_SHARE_JS_KEY=

# ── 알림톡(SOLAPI) ────────────────────────────────────────────────────────────
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER_PHONE=
SOLAPI_PF_ID_LAHOM=
SOLAPI_PF_ID_HAUD=
SOLAPI_TEMPLATE_MEASURE_ID_LAHOM=
SOLAPI_TEMPLATE_MEASURE_ID_HAUD=
SOLAPI_TEMPLATE_SHARE_ID_LAHOM=
SOLAPI_TEMPLATE_SHARE_ID_HAUD=
SOLAPI_TEMPLATE_SHARE_BOTH_ID_LAHOM=
SOLAPI_TEMPLATE_SHARE_BOTH_ID_HAUD=

# ── 채널톡 ────────────────────────────────────────────────────────────────────
CHANNEL_ID=
CHANNEL_APP_SECRET=
CHANNEL_SIGNING_KEY=
CHANNEL_DESK_URL=
CHANNEL_ALLOWED_GROUP_IDS=
CHANNEL_REPLAY_WINDOW_SECONDS=
CHANNEL_WEBHOOK_ENABLED=
CHANNEL_INBOUND_ENABLED=
CHANNEL_INBOUND_CREATE_ENABLED=
CHANNEL_COMMAND_ENABLED=
CHANNEL_WRITE_ACTION_ENABLED=
CHANNEL_PUSH_ENABLED=
CHANNEL_WAM_ENABLED=
CHANNEL_GROUP_GENERAL=
CHANNEL_GROUP_MEASUREMENT=
CHANNEL_GROUP_MEASURE_ROOM=
CHANNEL_GROUP_DRAWING=
CHANNEL_GROUP_ESTIMATE=
CHANNEL_GROUP_CONSTRUCTION=
CHANNEL_GROUP_AS=

# ── 네이버 커머스 ─────────────────────────────────────────────────────────────
NAVER_COMMERCE_CLIENT_ID=
NAVER_COMMERCE_CLIENT_SECRET=
FOMS_NAVER_AUTO_DISPATCH_AT=
FOMS_NAVER_SETTLE_SYNC_AT=

# ── Socket.IO ─────────────────────────────────────────────────────────────────
SOCKETIO_ASYNC_MODE=
SOCKETIO_CLIENT_ENABLED=
SOCKETIO_ALLOW_POLLING_FALLBACK=

# ── 관측·운영 ─────────────────────────────────────────────────────────────────
SENTRY_DSN=
FOMS_RUM_BASE_URL=
FOMS_BACKUP_HEARTBEAT_SECRET=
FOMS_OPS_CONTROL_ROOT=
FOMS_RUNTIME_OUTPUT_ROOT=

# ── 테스트·스테이징 도구 전용(운영 앱은 안 읽는다) ───────────────────────────
FOMS_TEST_DATABASE_URL=
FOMS_STAGING_BASE_URL=
FOMS_STAGING_USERNAME=
FOMS_STAGING_PASSWORD=
FOMS_STAGING_COOKIE=
FOMS_CHECK_DSN=
